{
  "name": "@carchalabs/seal-core",
  "version": "0.4.0",
  "description": "Carcha Seal (formerly LicenseKit) lease format: Ed25519-signed compact JWS, key sets, license keys and feature-key encryption",
  "keywords": ["licensing", "license-key", "software-licensing", "ed25519", "jws", "offline", "carcha-seal"],
  "homepage": "https://seal.carchalabs.com/docs/",
  "repository": { "type": "git", "url": "git+https://github.com/carcha-labs/carcha-seal-sdk.git", "directory": "packages/core" },
  "bugs": { "url": "https://github.com/carcha-labs/carcha-seal-sdk/issues" },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": { "seal-encrypt": "dist/encrypt-cli.js", "licensekit-encrypt": "dist/encrypt-cli.js" },
  "files": ["dist", "src", "!dist/**/*.test.*", "!src/**/*.test.ts"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "node --test dist/*.test.js"
  },
  "engines": { "node": ">=22.13" },
  "publishConfig": { "access": "public" },
  "license": "MIT"
}
