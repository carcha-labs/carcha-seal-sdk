{
  "name": "@carchalabs/licensekit-core",
  "version": "0.2.0",
  "description": "LicenseKit lease format: Ed25519-signed compact JWS, key sets, license keys and feature-key encryption",
  "homepage": "https://licensekit.carchalabs.com/docs/",
  "repository": { "type": "git", "url": "git+https://github.com/carcha-labs/licensekit-sdk.git", "directory": "packages/core" },
  "bugs": { "url": "https://github.com/carcha-labs/licensekit-sdk/issues" },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": { "licensekit-encrypt": "dist/encrypt-cli.js" },
  "files": ["dist", "src", "!dist/**/*.test.*", "!src/**/*.test.ts"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "node --test dist/*.test.js"
  },
  "engines": { "node": ">=22.13" },
  "publishConfig": { "access": "public" },
