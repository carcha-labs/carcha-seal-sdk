{
  "name": "@carchalabs/seal-quickstart",
  "version": "0.5.0",
  "description": "Try Carcha Seal (formerly LicenseKit) from a terminal: activate a trial key, then check the license offline",
  "keywords": ["licensing", "license-key", "electron", "quickstart", "carcha-seal"],
  "homepage": "https://seal.carchalabs.com/docs/",
