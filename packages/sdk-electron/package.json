{
  "name": "@carchalabs/licensekit-electron",
  "version": "0.3.0",
  "description": "LicenseKit SDK for the Electron main process and Node: activation, offline verification, grace period",
  "homepage": "https://licensekit.carchalabs.com/docs/",
  "repository": { "type": "git", "url": "git+https://github.com/carcha-labs/licensekit-sdk.git", "directory": "packages/sdk-electron" },
  "bugs": { "url": "https://github.com/carcha-labs/licensekit-sdk/issues" },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "src", "!dist/**/*.test.*", "!src/**/*.test.ts"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "node --no-warnings=ExperimentalWarning --test dist/*.test.js"
  },
  "dependencies": {
    "@carchalabs/licensekit-core": "0.2.0"
  },
  "optionalDependencies": {
    "@carchalabs/licensekit-hwid": "0.2.0"
  },
  "engines": { "node": ">=22.13" },
  "publishConfig": { "access": "public" },
  "license": "MIT"
}
