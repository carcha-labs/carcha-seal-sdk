<Project Sdk="Microsoft.NET.Sdk">
  <!-- CarchaLabs.Seal.Runtime: the library for .NET (Core) apps, with the native library per platform under
       runtimes/<rid>/native, which NuGet and the .NET runtime select. ref/ rather than lib/, so packages.config
       projects do not take it as compatible (Microsoft, "Native files in .NET packages"). -->
  <Import Project="../Pack.props" />
  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <PackageId>CarchaLabs.Seal.Runtime</PackageId>
    <!-- NU5131: NuGet's check asks for every file under ref/ (the .xml docs too) in a nuspec <references> element
         whenever ref/ is present without one (ReferencesInNuspecMatchRefAssetsRule); Microsoft's layout for this
         package is ref/ without <references>. -->
    <NoWarn>$(NoWarn);NU5131</NoWarn>
    <Description>Carcha Seal for .NET 5+ (and .NET Standard 2.0 hosts other than .NET Framework), with the native library for each platform. Install CarchaLabs.Seal instead: it picks this package or CarchaLabs.Seal.NetFramework for your app.</Description>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(SealLibraryBin)net10.0/CarchaLabs.Seal.dll;$(SealLibraryBin)net10.0/CarchaLabs.Seal.xml" Pack="true" PackagePath="ref/net10.0;runtimes/any/lib/net10.0" />
    <None Include="$(SealLibraryBin)netstandard2.0/CarchaLabs.Seal.dll;$(SealLibraryBin)netstandard2.0/CarchaLabs.Seal.xml" Pack="true" PackagePath="ref/netstandard2.0;runtimes/any/lib/netstandard2.0" />
    <None Include="$(SealNativeDir)win-x86/seal_native.dll" Condition="Exists('$(SealNativeDir)win-x86/seal_native.dll')" Pack="true" PackagePath="runtimes/win-x86/native/" />
    <None Include="$(SealNativeDir)win-x64/seal_native.dll" Condition="Exists('$(SealNativeDir)win-x64/seal_native.dll')" Pack="true" PackagePath="runtimes/win-x64/native/" />
    <None Include="$(SealNativeDir)win-arm64/seal_native.dll" Condition="Exists('$(SealNativeDir)win-arm64/seal_native.dll')" Pack="true" PackagePath="runtimes/win-arm64/native/" />
    <None Include="$(SealNativeDir)osx-x64/libseal_native.dylib" Condition="Exists('$(SealNativeDir)osx-x64/libseal_native.dylib')" Pack="true" PackagePath="runtimes/osx-x64/native/" />
    <None Include="$(SealNativeDir)osx-arm64/libseal_native.dylib" Condition="Exists('$(SealNativeDir)osx-arm64/libseal_native.dylib')" Pack="true" PackagePath="runtimes/osx-arm64/native/" />
    <None Include="$(SealNativeDir)linux-x64/libseal_native.so" Condition="Exists('$(SealNativeDir)linux-x64/libseal_native.so')" Pack="true" PackagePath="runtimes/linux-x64/native/" />
    <None Include="$(SealNativeDir)linux-arm64/libseal_native.so" Condition="Exists('$(SealNativeDir)linux-arm64/libseal_native.so')" Pack="true" PackagePath="runtimes/linux-arm64/native/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
</Project>
