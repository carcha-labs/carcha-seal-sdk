<?xml version="1.0" encoding="utf-8"?>
<!-- The packages from ../../artifacts/packages (dotnet pack, see ../../README.md), and nuget.org for the reference
     assemblies. Packages are kept in .packages/ here, so a rebuilt 0.1.0 is never taken from an older cache. -->
<configuration>
  <packageSources>
    <clear />
    <add key="local" value="../../artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="CarchaLabs.Seal" />
      <package pattern="CarchaLabs.Seal.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <config>
    <add key="globalPackagesFolder" value=".packages" />
  </config>
</configuration>
