<?xml version="1.0" encoding="utf-8"?>
<!-- packages.config lists every package, the dependency too: CarchaLabs.Seal (no files) and the package it brings
     to .NET Framework apps. The versions are the one ../../../pack/Pack.props writes. -->
<packages>
  <package id="CarchaLabs.Seal" version="0.1.0" targetFramework="net48" />
  <package id="CarchaLabs.Seal.NetFramework" version="0.1.0" targetFramework="net48" />
</packages>
