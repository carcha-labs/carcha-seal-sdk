<?xml version="1.0" encoding="utf-8"?>
<!-- A packages.config (non-SDK) .NET Framework 4.8 app, as Visual Studio writes one when the package is installed:
     a reference to the library in packages\ and an Import of the package's build\net462 targets (packages.config
     restore does not add imports; installing the package does). Built with Visual Studio's MSBuild:
       nuget restore packages.config -PackagesDirectory ..\packages -ConfigFile ..\nuget.config
       MSBuild Legacy.csproj -p:Configuration=Release -p:Platform=x86   (or x64, AnyCPU) -->
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">AnyCPU</Platform>
    <OutputType>Exe</OutputType>
    <RootNamespace>Legacy</RootNamespace>
    <AssemblyName>Legacy</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <OutputPath>bin\$(Platform)\</OutputPath>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Optimize>true</Optimize>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SealPackages>..\packages\</SealPackages>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Net.Http" />
    <Reference Include="CarchaLabs.Seal">
      <HintPath>$(SealPackages)CarchaLabs.Seal.NetFramework.0.1.0\lib\net462\CarchaLabs.Seal.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Program.cs" />
    <None Include="packages.config" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Import Project="$(SealPackages)CarchaLabs.Seal.NetFramework.0.1.0\build\net462\CarchaLabs.Seal.NetFramework.targets" Condition="Exists('$(SealPackages)CarchaLabs.Seal.NetFramework.0.1.0\build\net462\CarchaLabs.Seal.NetFramework.targets')" />
  <Target Name="EnsureNuGetPackageBuildImports" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(SealPackages)CarchaLabs.Seal.NetFramework.0.1.0\build\net462\CarchaLabs.Seal.NetFramework.targets')" Text="CarchaLabs.Seal.NetFramework 0.1.0 is not in $(SealPackages): run nuget restore first." />
  </Target>
</Project>
