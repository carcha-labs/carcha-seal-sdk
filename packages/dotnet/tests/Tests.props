<Project>
  <!-- Shared by both test projects: the tests, xUnit, the client scenarios, and the native library built with cargo
       (packages/native) next to the test assembly. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SealNativeDir>$(MSBuildThisFileDirectory)../../native/</SealNativeDir>
    <SealCargoTarget>$(MSBuildThisFileDirectory)../../native/target/</SealCargoTarget>
    <SealNativeFile Condition="$([MSBuild]::IsOSPlatform('Windows'))">seal_native.dll</SealNativeFile>
    <SealNativeFile Condition="$([MSBuild]::IsOSPlatform('OSX'))">libseal_native.dylib</SealNativeFile>
    <SealNativeFile Condition="'$(SealNativeFile)' == ''">libseal_native.so</SealNativeFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Shared/*.cs" />
    <None Include="$(MSBuildThisFileDirectory)../../client/tests/vectors.json" Link="vectors.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <Target Name="SealBuildNative" BeforeTargets="Build">
    <Exec Command="cargo build --release --manifest-path &quot;$(SealNativeDir)Cargo.toml&quot; --target-dir &quot;$(SealCargoTarget)&quot;" />
    <Copy SourceFiles="$(SealCargoTarget)release/$(SealNativeFile)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
